# =====================================================================
# ZERO-CLICK STORE OPERATOR - PHONE VOICE CHANNEL (.env)
# =====================================================================

# 1. Team's Shared Backend REST API URL
# Connects to teammate's FastAPI server that exposes /api/products and /api/orders
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=6.0

# 2. OpenAI API Configuration
# Used for natural language understanding and autonomous tool calling
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Set to false to test basic Twilio voice echo loop without using OpenAI API
ENABLE_LLM_AGENT=true

# 3. Twilio Settings (Speech Recognition & TTS Voice)
TWILIO_VOICE_LANGUAGE=hi-IN
TWILIO_VOICE_NAME=Polly.Aditi

# 4. Store Branding
STORE_NAME=Zero-Click Store
DEFAULT_GREETING=Namaste! Zero-Click Store mein aapka swagat hai. Boliye bhaiya, aaj kya mangwana hai?

# 5. Server Run Configuration
HOST=0.0.0.0
PORT=8000
